{
  "name": "openclaw-icloud-calendar",
  "version": "0.1.0",
  "description": "OpenClaw plugin: read and write Apple iCloud Calendar server-to-server over CalDAV with an Apple ID and app-specific password. Zero runtime dependencies, runs anywhere Node runs.",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "compat": { "pluginApi": ">=2026.6.5" },
    "build": { "openclawVersion": "2026.6.5", "pluginSdkVersion": "2026.6.5" }
  },
  "files": ["dist/", "marketplace.json", "openclaw.plugin.json", "skills/", "src/"],
  "keywords": ["openclaw", "openclaw-plugin", "icloud", "apple", "calendar", "caldav"],
  "author": { "name": "Omar Shahine", "email": "omar@shahine.com" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/omarshahine/openclaw-icloud-calendar.git" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "ICLOUD_INTEGRATION=1 vitest run test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "prepack": "npm run build"
  }
}
